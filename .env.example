VITE_APP_VERSION=1.0.0
VITE_APP_NAME=Driver ID Map App
VITE_APP_DESCRIPTION=Driver ID Map App for tracking driver locations
VITE_APP_AUTHOR=Jalat Logistics
VITE_MODE=development

# Google Maps
VITE_GOOGLE_MAPS_API_KEY=

# MQTT broker (secure WebSocket listener on 443 - the raw TCP 1883 port is not browser-reachable)
VITE_MQTT_WS_URL=wss://mqtt-dev.jalatlogistics.com/mqtt
VITE_MQTT_USERNAME=admin@jalatlogistics.com
VITE_MQTT_PASSWORD=
VITE_MQTT_TOPIC=/topic/driver/+/location

# Pickup/parcel polling interval — fetched from Jalat-Order-Service's getOrderListByUser (VITE_ORDER_SERVICE_URL)
VITE_PICKUP_POLL_INTERVAL_MS=15000

# Backend GraphQL APIs (Jalat-User-Service / Jalat-Location-Service) — used
# for real driver login, the online/offline toggle, and the admin filter.
# Local dev defaults; point at your actual dev/uat host before deploying.
VITE_USER_SERVICE_URL=http://localhost:8081/v1
VITE_ORDER_SERVICE_URL=http://localhost:8082/v1
VITE_PAYMENT_SERVICE_URL=http://localhost:8083/v1
VITE_LOCATION_SERVICE_URL=http://localhost:8084/v1

# Jalat-Driver-Pickup-Service local port also defaults to 8084, same as Location Service — don't run both locally at once without changing one's PORT.
VITE_DRIVER_API_BASE_URL=http://localhost:8084/v1

# Dev-only: skip real login/online-toggle backend calls, use bundled sample profile instead.
VITE_DEV_BYPASS_AUTH=false
